{
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "languagelineage.org" }],
      "destination": "https://www.languagelineage.org/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/explore", "destination": "/index.html" },
    { "source": "/embed", "destination": "/index.html" }
  ]
}
