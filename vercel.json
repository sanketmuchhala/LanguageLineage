{
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "languagelineage.org" }],
      "destination": "https://www.languagelineage.org/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/explore", "destination": "/index.html" },
    { "source": "/embed", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/dataset/:version(v\\d+)/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=31536000, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
